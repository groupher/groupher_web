{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "assets-hub-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "assets-hub-test",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATED_IMAGE_BATCHES",
        "class_name": "GeneratedImageBatchDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-generated-image-batches",
      "new_sqlite_classes": ["GeneratedImageBatchDO"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASSET_DELETE_QUEUE",
        "queue": "assets-hub-test-delete",
      },
    ],
  },
}
